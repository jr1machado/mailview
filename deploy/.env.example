# Artefatos MailView: use sempre uma tag imutável em produção.
MAILVIEW_IMAGE=ghcr.io/jr1machado/mailview:v0.4.0
MAILVIEW_PROXY_IMAGE=caddy:2.10-alpine
MAILVIEW_POSTGRES_IMAGE=postgres:17-alpine

MAILVIEW_PUBLIC_HOST=mailview.example.com
MAILVIEW_DOMAIN_REVALIDATION_INTERVAL=24h
MAILVIEW_TENANT_ROUTING_ENABLED=false
MAILVIEW_TENANT_BASE_DOMAIN=
TZ=Etc/UTC

# Caminhos locais; os valores ficam fora do Git.
MAILVIEW_DB_USER_FILE=./secrets/postgres-user
MAILVIEW_DB_PASSWORD_FILE=./secrets/postgres-password
MAILVIEW_APP_DB_PASSWORD_FILE=./secrets/app-db-password
MAILVIEW_MFA_KEY_FILE=./secrets/mfa-encryption-key
MAILVIEW_IMPORT_KEY_FILE=./secrets/import-signing-key
