# Tags imutáveis publicadas pelo pipeline. Não use :latest em produção.
MAILVIEW_PROXY_IMAGE=traefik:v3.5.3
MAILVIEW_API_IMAGE=ghcr.io/jr1machado/mailview-api:0.1.0
MAILVIEW_WORKER_IMAGE=ghcr.io/jr1machado/mailview-worker:0.1.0
MAILVIEW_FRONTEND_IMAGE=ghcr.io/jr1machado/mailview-frontend:0.1.0
MAILVIEW_POSTGRES_IMAGE=postgres:17.5-alpine
MAILVIEW_REDIS_IMAGE=redis:8.0

# Caminhos locais de secrets, nunca valores de segredo.
MAILVIEW_DB_USER_FILE=./secrets/postgres-user
MAILVIEW_DB_PASSWORD_FILE=./secrets/postgres-password
MAILVIEW_DB_NAME_FILE=./secrets/postgres-db
MAILVIEW_DATABASE_URL_FILE=./secrets/database-url
