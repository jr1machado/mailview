# A simpler version of the service template with wider compatibility for older OS's

[Unit]
Description=MailView email platform
ConditionPathExists=/etc/mailview/config.toml
Wants=network.target
# The PostgreSQL database may not be on the same host but if it
# is local, MailView should wait for it to start up.
After=postgresql.service

[Service]
Type=simple
PermissionsStartOnly=true
WorkingDirectory=/etc/mailview
ExecStartPre=/usr/bin/mkdir -p "/etc/mailview/uploads"
ExecStartPre=/usr/bin/MailView --config /etc/mailview/config.toml --upgrade --yes
ExecStart=/usr/bin/MailView --config /etc/mailview/config.toml
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

# To enable a static dir, add the following 
# --static-dir /etc/mailview/static
# to the end of the ExecStart line above after creating the dir and fetching the files with:
# Configure --static-dir only when serving unpacked development assets.

# To enable a log file that persists after restarts, replace the ExecStart= line with:
# ExecStart=/bin/bash -ce "exec /usr/bin/MailView --config /etc/mailview/config.toml >>/var/log/mailview.log 2>&1"

# Set user to run MailView as (instead of root).
# Can use "DynamicUser=" instead, if your systemd version is >= 232.
# https://www.freedesktop.org/software/systemd/man/latest/systemd.exec.html#DynamicUser=
#User=
#StateDirectory=mailview
#Environment=HOME=/usr/bin

# Use systemd’s ability to disable security-sensitive features
# that MailView does not explicitly need.
# NoNewPrivileges should be enabled by DynamicUser=yes but systemd-analyze
# still recommended to explicitly enable it.
NoNewPrivileges=True
# MailView does not need any Linux capabilities.
# see: https://man7.org/linux/man-pages/man7/capabilities.7.html
CapabilityBoundingSet=
# MailView only executes native code with no need for any other ABIs.
SystemCallArchitectures=native

# Make /home/, /root/, and /run/user/ inaccessible.
# ProtectSystem=strict and ProtectHome=read-only are implied by DynamicUser=True
# Keep uploads in a StateDirectory or another explicitly writable path.
# See https://github.com/knadh/listmonk/issues/843#issuecomment-1836023524
ProtectHome=True

# Make files readable only by the MailView service group.
UMask=0027
# MailView only needs IPv4 and IPv6 address families.
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
