[app]
# Interface and port where the app will run its webserver.  The default value
# of localhost will only listen to connections from the current machine. To
# listen on all interfaces use '0.0.0.0'. To listen on the default web address
# port, use port 80 (this will require running with elevated permissions).
address = "localhost:9000"

# MailView SaaS extensions. Generate a 32-byte key and encode it in base64.
# In production provide LISTMONK_mailview__mfa_encryption_key_FILE via a secret.
[mailview]
mfa_encryption_key = ""
tenant_routing_enabled = false
tenant_base_domain = ""

# Root directory for tenant-scoped import uploads. Each job's CSV is written
# under <import_storage_dir>/<tenant_id>/, isolated from every other tenant.
import_storage_dir = "./mailview-imports"

# HMAC key that signs each uploaded import file. Generate a 32-byte key and
# encode it in base64, same as mfa_encryption_key. Import jobs are disabled
# until this is set.
import_signing_key = ""

# Database.
[db]
host = "localhost"
port = 5432
user = "listmonk"
password = "listmonk"

# Ensure that this database has been created in Postgres.
database = "listmonk"

ssl_mode = "disable"
max_open = 25
max_idle = 25
max_lifetime = "300s"

# Optional space separated Postgres DSN params. eg: "application_name=listmonk gssencmode=disable"
params = ""
